#!/usr/bin/env bash
#
# Резервное копирование серверов Nekta (pull-модель).
#
# Копии забирает сервер резервного копирования, а не отдаёт защищаемый сервер.
# Так скомпрометированный или вышедший из строя сервер Nekta не может испортить
# архив: у него нет ни доступа к хранилищу, ни прав на удаление снимков.
#
# Схема одного цикла:
#   1) на источнике выполняется nekta-predump — согласованные дампы СУБД;
#   2) rsync --link-dest переносит изменения в новый каталог-снимок;
#      неизменившиеся файлы становятся жёсткими ссылками на предыдущий снимок,
#      поэтому каждый снимок выглядит полным, а места занимает как инкремент;
#   3) при backup_engine=borg снимок дополнительно кладётся в дедуплицированный
#      репозиторий;
#   4) старые снимки прореживаются по схеме дед-отец-сын.
#
# Использование:
#   nekta-backup                  все источники
#   nekta-backup --source nekta-01
#   nekta-backup --dry-run        показать, что было бы скопировано
set -uo pipefail

CONF=/etc/nekta/backup.conf
CONF_DIR=/etc/nekta/backup.conf.d
LOG_TAG=nekta-backup

[[ -r "$CONF" ]] || { echo "нет $CONF" >&2; exit 2; }
# shellcheck source=/dev/null
source "$CONF"

DRY_RUN=0
ONLY_SOURCE=""
EXIT_CODE=0

# Каждый источник обрабатывается в подоболочке (чтобы переменные из его
# конфигурации не протекали в следующий), поэтому отчёт и признак ошибки
# накапливаются в файлах, а не в переменных.
REPORT_FILE=$(mktemp /tmp/nekta-backup-report.XXXXXX)
FAIL_FLAG="${REPORT_FILE}.failed"
trap 'rm -f "$REPORT_FILE" "$FAIL_FLAG"' EXIT

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) DRY_RUN=1; shift ;;
        --source)  ONLY_SOURCE="${2:-}"; shift 2 ;;
        -h|--help) sed -n '2,30p' "$0"; exit 0 ;;
        *) echo "неизвестный аргумент: $1" >&2; exit 2 ;;
    esac
done

mkdir -p "$LOG_DIR" "$STATE_DIR"
RUN_LOG="$LOG_DIR/backup-$(date +%Y%m%d-%H%M%S).log"
exec > >(tee -a "$RUN_LOG") 2>&1

log()  { printf '[%s] %s\n' "$(date '+%F %T')" "$*"; logger -t "$LOG_TAG" -- "$*"; }
note() { log "$*"; printf '%s\n' "$*" >> "$REPORT_FILE"; }
fail() { log "ОШИБКА: $*"; printf 'ОШИБКА: %s\n' "$*" >> "$REPORT_FILE"; : > "$FAIL_FLAG"; }

# --- Проверка свободного места -------------------------------------------
check_free_space() {
    local avail_pct
    avail_pct=$(df --output=pcent "$BACKUP_ROOT" | tail -1 | tr -dc '0-9')
    avail_pct=$((100 - avail_pct))
    if (( avail_pct < MIN_FREE_PERCENT )); then
        fail "на $BACKUP_ROOT свободно ${avail_pct}%, минимум ${MIN_FREE_PERCENT}%. Копирование остановлено, чтобы не заполнить том целиком."
        return 1
    fi
    log "свободно на $BACKUP_ROOT: ${avail_pct}%"
    return 0
}

# --- Прореживание снимков по схеме дед-отец-сын ---------------------------
# Оставляем: KEEP_DAILY последних снимков, по одному на каждую из KEEP_WEEKLY
# последних недель и по одному на каждый из KEEP_MONTHLY последних месяцев.
prune_snapshots() {
    local dir="$1"
    local -a snaps keep
    local s key
    local -A seen_week seen_month
    local d=0 w=0 m=0

    mapfile -t snaps < <(find "$dir" -maxdepth 1 -mindepth 1 -type d \
        -regextype posix-extended -regex '.*/[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{6}$' \
        -printf '%f\n' | sort -r)

    (( ${#snaps[@]} == 0 )) && return 0

    for s in "${snaps[@]}"; do
        if (( d < KEEP_DAILY )); then
            keep+=("$s"); (( d++ )); continue
        fi
        key=$(date -d "${s:0:10}" +%G-%V 2>/dev/null) || continue
        if [[ -z "${seen_week[$key]:-}" ]] && (( w < KEEP_WEEKLY )); then
            seen_week[$key]=1; keep+=("$s"); (( w++ )); continue
        fi
        key=$(date -d "${s:0:10}" +%Y-%m 2>/dev/null) || continue
        if [[ -z "${seen_month[$key]:-}" ]] && (( m < KEEP_MONTHLY )); then
            seen_month[$key]=1; keep+=("$s"); (( m++ )); continue
        fi
    done

    local removed=0
    for s in "${snaps[@]}"; do
        if [[ " ${keep[*]} " != *" $s "* ]]; then
            if (( DRY_RUN )); then
                log "  [dry-run] удалить снимок $s"
            else
                rm -rf -- "${dir:?}/$s" && (( removed++ ))
            fi
        fi
    done
    note "  снимков оставлено: ${#keep[@]}, удалено: $removed"
}

# --- Копирование одного источника ----------------------------------------
backup_source() {
    local conf="$1"
    # shellcheck source=/dev/null
    source "$conf"

    local started elapsed
    started=$(date +%s)
    # NAME, HOST, PORT, SSH_USER, PATHS, EXCLUDES, PREDUMP заданы в конфигурации
    # источника, загруженной строкой выше.
    # shellcheck disable=SC2153
    note "=== источник: $NAME ($SSH_USER@$HOST:$PORT) ==="

    local snap_dir="$BACKUP_ROOT/snapshots/$NAME"
    local stamp; stamp=$(date +%Y-%m-%d_%H%M%S)
    local target="$snap_dir/$stamp"
    local incomplete="$snap_dir/.incomplete-$stamp"
    local latest="$snap_dir/latest"
    mkdir -p "$snap_dir"

    local ssh_cmd="ssh -p $PORT -i $SSH_KEY -o BatchMode=yes -o ConnectTimeout=15 -o ServerAliveInterval=30"

    # 1. Согласованные дампы БД на стороне источника.
    if [[ "${PREDUMP:-yes}" == "yes" ]]; then
        log "запускаю подготовку дампов на $HOST"
        if (( DRY_RUN )); then
            log "  [dry-run] ssh $SSH_USER@$HOST sudo /usr/local/sbin/nekta-predump"
        elif $ssh_cmd "$SSH_USER@$HOST" "sudo -n /usr/local/sbin/nekta-predump"; then
            log "дампы готовы"
        else
            # Копию всё равно снимаем: файлы приложения и конфигурация ценны
            # сами по себе, даже если логический дамп БД не удался.
            fail "$NAME: подготовка дампов завершилась с ошибкой, копирование продолжается"
        fi
    fi

    # 2. Перенос данных.
    local -a rsync_opts=(
        --archive --hard-links --acls --xattrs --sparse
        --numeric-ids --delete --delete-excluded
        --human-readable --stats
        --partial --timeout=1800
        --rsync-path="sudo -n rsync"
        -e "$ssh_cmd"
    )
    (( DRY_RUN )) && rsync_opts+=(--dry-run)
    (( BWLIMIT > 0 )) && rsync_opts+=(--bwlimit="$BWLIMIT")

    local ex
    for ex in "${EXCLUDES[@]}"; do
        rsync_opts+=(--exclude="$ex")
    done

    mkdir -p "$incomplete"
    local path rc rsync_rc=0
    local -a path_opts
    for path in "${PATHS[@]}"; do
        log "копирую $HOST:$path"
        mkdir -p "$incomplete/${path#/}"
        path_opts=()
        # --link-dest сравнивается с тем же подкаталогом предыдущего снимка:
        # указание на его корень сделало бы жёсткие ссылки бесполезными.
        if [[ -d "$latest/${path#/}" ]]; then
            path_opts+=(--link-dest="$(readlink -f "$latest")/${path#/}")
        fi
        rsync "${rsync_opts[@]}" "${path_opts[@]}" \
            "$SSH_USER@$HOST:$path/" "$incomplete/${path#/}/"
        rc=$?
        # 24 — «исходные файлы исчезли во время копирования»: нормально для
        # временных файлов работающей системы, ошибкой не считаем.
        if (( rc != 0 && rc != 24 )); then
            fail "$NAME: rsync вернул код $rc на пути $path"
            rsync_rc=$rc
        fi
    done

    if (( DRY_RUN )); then
        rm -rf -- "$incomplete"
        note "  [dry-run] снимок не создан"
        return 0
    fi

    if (( rsync_rc != 0 )); then
        # Неполный снимок не должен стать базой для следующего --link-dest.
        mv -- "$incomplete" "$snap_dir/FAILED-$stamp"
        fail "$NAME: снимок сохранён как FAILED-$stamp, ссылка latest не обновлена"
        return 1
    fi

    mv -- "$incomplete" "$target"
    ln -sfn "$target" "$latest"
    local size; size=$(du -sh "$target" 2>/dev/null | cut -f1)
    local total; total=$(du -sh "$snap_dir" 2>/dev/null | cut -f1)
    note "  снимок $stamp создан, логический объём $size, всего по источнику $total"

    # 3. Дедуплицированный архив (опционально).
    if [[ "$ENGINE" == "borg" ]]; then
        archive_to_borg "$NAME" "$target" "$stamp"
    fi

    # 4. Прореживание.
    prune_snapshots "$snap_dir"

    elapsed=$(( $(date +%s) - started ))
    note "  время выполнения: $((elapsed / 60)) мин $((elapsed % 60)) с"
    write_status "$NAME" "$stamp" "$elapsed" "$size"
}

archive_to_borg() {
    local name="$1" src="$2" stamp="$3"
    local repo="$BACKUP_ROOT/borg/$name"
    [[ -d "$repo" ]] || { fail "$name: репозиторий borg $repo не инициализирован"; return 1; }

    export BORG_PASSPHRASE="${BORG_PASSPHRASE:-}"
    export BORG_RELOCATED_REPO_ACCESS_IS_OK=yes

    log "создаю архив borg $name::$stamp"
    if borg create --stats --compression "$BORG_COMPRESSION" \
        "$repo::$stamp" "$src" >/dev/null 2>>"$RUN_LOG"; then
        borg prune --keep-daily="$KEEP_DAILY" --keep-weekly="$KEEP_WEEKLY" \
            --keep-monthly="$KEEP_MONTHLY" "$repo" >/dev/null 2>>"$RUN_LOG" \
            || fail "$name: borg prune завершился с ошибкой"
        borg compact "$repo" >/dev/null 2>&1 || true
        note "  архив borg создан"
    else
        fail "$name: borg create завершился с ошибкой"
    fi
    unset BORG_PASSPHRASE
}

write_status() {
    local name="$1" stamp="$2" elapsed="$3" size="$4"
    local f="$STATE_DIR/status-$name.json"
    cat > "$f" <<JSON
{
  "source": "$name",
  "last_success": "$(date -Iseconds)",
  "last_success_epoch": $(date +%s),
  "snapshot": "$stamp",
  "duration_seconds": $elapsed,
  "size": "$size",
  "engine": "$ENGINE"
}
JSON
}

send_report() {
    local subject="$1"
    [[ "$MAIL_ENABLED" == "yes" ]] || return 0
    [[ "$MAIL_POLICY" == "always" || $EXIT_CODE -ne 0 ]] || return 0
    printf 'Сервер резервного копирования: %s\nЖурнал: %s\n\n%s\n' \
        "$(hostname -f)" "$RUN_LOG" "$(cat "$REPORT_FILE")" \
        | mail -s "$subject" "$MAIL_TO" 2>/dev/null || log "не удалось отправить отчёт"
}

# --- Основной цикл --------------------------------------------------------
log "запуск резервного копирования (движок: $ENGINE${DRY_RUN:+, режим проверки})"

if ! check_free_space; then
    send_report "[NEKTA][ОШИБКА] Резервное копирование не запущено: нет места"
    exit 1
fi

# Один экземпляр за раз: параллельные запуски портят --link-dest и ротацию.
exec 9>"$STATE_DIR/backup.lock"
if ! flock -n 9; then
    log "предыдущий запуск ещё не завершён — выходим"
    exit 0
fi

shopt -s nullglob
confs=("$CONF_DIR"/*.conf)
shopt -u nullglob

if (( ${#confs[@]} == 0 )); then
    fail "в $CONF_DIR нет описаний источников"
else
    for conf in "${confs[@]}"; do
        if [[ -n "$ONLY_SOURCE" && "$(basename "$conf" .conf)" != "$ONLY_SOURCE" ]]; then
            continue
        fi
        ( backup_source "$conf" ) || EXIT_CODE=1
    done
fi

# Ошибки, зафиксированные внутри подоболочек.
[[ -e "$FAIL_FLAG" ]] && EXIT_CODE=1

if (( EXIT_CODE == 0 )); then
    log "резервное копирование завершено успешно"
    send_report "[NEKTA][OK] Резервное копирование выполнено"
else
    log "резервное копирование завершено с ошибками"
    send_report "[NEKTA][ОШИБКА] Резервное копирование завершено с ошибками"
fi

exit "$EXIT_CODE"
