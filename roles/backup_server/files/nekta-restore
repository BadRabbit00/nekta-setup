#!/usr/bin/env bash
#
# Восстановление данных из резервных копий Nekta.
#
# Снимки хранятся обычными файлами, поэтому восстановление не требует ни этой
# утилиты, ни специального ПО: подойдёт cp или rsync. Скрипт лишь избавляет от
# ручного набора длинных путей и по умолчанию работает в режиме проверки.
#
# Порядок восстановления сервера Nekta целиком описан в docs/05-restore.md.
set -uo pipefail

CONF=/etc/nekta/backup.conf
[[ -r "$CONF" ]] || { echo "нет $CONF" >&2; exit 2; }
# shellcheck source=/dev/null
source "$CONF"

usage() {
    cat <<'USAGE'
Использование:
  nekta-restore list [ИСТОЧНИК]
        показать доступные снимки

  nekta-restore info ИСТОЧНИК СНИМОК
        состав снимка и его размер

  nekta-restore extract ИСТОЧНИК СНИМОК ПУТЬ КУДА
        распаковать путь из снимка в локальный каталог
        (ПУТЬ указывается как на исходном сервере, например /nekta/backup-dumps)

  nekta-restore push ИСТОЧНИК СНИМОК ПУТЬ ХОСТ:КАТАЛОГ [--apply]
        вернуть данные на сервер; без --apply выполняется проверочный прогон

Примеры:
  nekta-restore list nekta-01
  nekta-restore extract nekta-01 2026-09-01_013000 /nekta/backup-dumps/latest /tmp/dump
  nekta-restore push nekta-01 2026-09-01_013000 /etc/nekta nekta-01:/etc/nekta --apply
USAGE
}

snap_root() { printf '%s/snapshots/%s' "$BACKUP_ROOT" "$1"; }

require_snapshot() {
    local dir
    dir="$(snap_root "$1")/$2"
    [[ -d "$dir" ]] || { echo "снимок не найден: $dir" >&2; exit 1; }
    printf '%s' "$dir"
}

cmd_list() {
    local src="${1:-}"
    local dirs=()
    if [[ -n "$src" ]]; then
        dirs=("$(snap_root "$src")")
    else
        mapfile -t dirs < <(find "$BACKUP_ROOT/snapshots" -maxdepth 1 -mindepth 1 -type d | sort)
    fi
    local d
    for d in "${dirs[@]}"; do
        [[ -d "$d" ]] || continue
        printf '\n== %s ==\n' "$(basename "$d")"
        find "$d" -maxdepth 1 -mindepth 1 -type d \
            -regextype posix-extended -regex '.*/[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{6}$' \
            -printf '%f\n' | sort -r | while read -r s; do
            printf '  %s  %s\n' "$s" "$(du -sh "$d/$s" 2>/dev/null | cut -f1)"
        done
        local failed
        failed=$(find "$d" -maxdepth 1 -name 'FAILED-*' -printf '%f\n' 2>/dev/null | sort -r)
        # sed добавляет отступ к каждой строке списка; подстановка параметра
        # так не умеет.
        # shellcheck disable=SC2001
        [[ -n "$failed" ]] && printf '  незавершённые снимки:\n%s\n' "$(sed 's/^/    /' <<<"$failed")"
    done
}

cmd_info() {
    local dir; dir=$(require_snapshot "$1" "$2")
    printf 'Снимок:  %s\nОбъём:   %s\nСоздан:  %s\n\nКорневые каталоги:\n' \
        "$dir" "$(du -sh "$dir" | cut -f1)" "$(stat -c %y "$dir" | cut -d. -f1)"
    find "$dir" -maxdepth 2 -mindepth 1 -type d -printf '  %p\n' | head -40
}

cmd_extract() {
    local dir; dir=$(require_snapshot "$1" "$2")
    local path="$3" dest="$4"
    local src="$dir/${path#/}"
    [[ -e "$src" ]] || { echo "в снимке нет пути $path" >&2; exit 1; }
    mkdir -p "$dest"
    echo "восстанавливаю $src -> $dest"
    rsync --archive --hard-links --acls --xattrs --numeric-ids --info=progress2 "$src" "$dest/"
    echo "готово"
}

cmd_push() {
    local dir; dir=$(require_snapshot "$1" "$2")
    local path="$3" target="$4" apply="${5:-}"
    local source_conf="/etc/nekta/backup.conf.d/$1.conf"
    # Пользователь и порт берутся из описания источника: у агента бэкапа уже
    # есть точечные права sudo на rsync, отдельная учётная запись не нужна.
    # shellcheck source=/dev/null
    [[ -r "$source_conf" ]] && source "$source_conf"
    local remote_user="${SSH_USER:-root}" remote_port="${PORT:-22}"
    local src="$dir/${path#/}"
    [[ -e "$src" ]] || { echo "в снимке нет пути $path" >&2; exit 1; }

    local host="${target%%:*}" remote="${target#*:}"
    local -a opts=(--archive --hard-links --acls --xattrs --numeric-ids
                   --human-readable --itemize-changes
                   -e "ssh -i $SSH_KEY -p $remote_port -o BatchMode=yes"
                   --rsync-path="sudo -n rsync")

    if [[ "$apply" != "--apply" ]]; then
        opts+=(--dry-run)
        echo "ПРОВЕРОЧНЫЙ ПРОГОН (данные не изменяются). Для записи добавьте --apply."
    else
        echo "ВНИМАНИЕ: данные на $host будут перезаписаны из снимка $2."
        read -r -p "Продолжить? введите ДА: " answer
        [[ "$answer" == "ДА" ]] || { echo "отменено"; exit 1; }
    fi

    rsync "${opts[@]}" "$src/" "$remote_user@$host:$remote/"
}

case "${1:-}" in
    list)    shift; cmd_list "$@" ;;
    info)    shift; [[ $# -eq 2 ]] || { usage; exit 2; }; cmd_info "$@" ;;
    extract) shift; [[ $# -eq 4 ]] || { usage; exit 2; }; cmd_extract "$@" ;;
    push)    shift; [[ $# -ge 4 ]] || { usage; exit 2; }; cmd_push "$@" ;;
    *)       usage; exit 2 ;;
esac
