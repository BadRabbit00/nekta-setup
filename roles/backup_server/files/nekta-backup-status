#!/usr/bin/env bash
#
# Контроль состояния резервных копий.
#
# Копия, о которой никто не знает, что она перестала сниматься, — это отсутствие
# копии. Скрипт вызывается таймером nekta-backup-check.timer и возвращает
# ненулевой код, если хотя бы один источник просрочен; его же удобно опрашивать
# внешним мониторингом.
set -uo pipefail

CONF=/etc/nekta/backup.conf
[[ -r "$CONF" ]] || { echo "нет $CONF" >&2; exit 2; }
# shellcheck source=/dev/null
source "$CONF"

QUIET=0
[[ "${1:-}" == "--quiet" ]] && QUIET=1

now=$(date +%s)
rc=0
problems=""

say() { (( QUIET )) || printf '%s\n' "$*"; }

say "Состояние резервных копий на $(hostname -f), проверка $(date '+%F %T')"
say ""

df -h "$BACKUP_ROOT" | sed 's/^/  /' | while read -r line; do say "$line"; done
say ""

used_pct=$(df --output=pcent "$BACKUP_ROOT" | tail -1 | tr -dc '0-9')
free_pct=$((100 - used_pct))
if (( free_pct < MIN_FREE_PERCENT )); then
    problems+="Свободного места на $BACKUP_ROOT всего ${free_pct}% (порог ${MIN_FREE_PERCENT}%)"$'\n'
    rc=1
fi

shopt -s nullglob
for conf in /etc/nekta/backup.conf.d/*.conf; do
    name=$(basename "$conf" .conf)
    status_file="$STATE_DIR/status-$name.json"

    if [[ ! -f "$status_file" ]]; then
        problems+="$name: успешных копий ещё не было"$'\n'
        rc=1
        say "  [ НЕТ КОПИЙ ] $name"
        continue
    fi

    last_epoch=$(grep -o '"last_success_epoch": *[0-9]*' "$status_file" | tr -dc '0-9')
    snapshot=$(grep -o '"snapshot": *"[^"]*"' "$status_file" | cut -d'"' -f4)
    age_h=$(( (now - last_epoch) / 3600 ))
    count=$(find "$BACKUP_ROOT/snapshots/$name" -maxdepth 1 -mindepth 1 -type d \
        -regextype posix-extended -regex '.*/[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{6}$' 2>/dev/null | wc -l)
    failed=$(find "$BACKUP_ROOT/snapshots/$name" -maxdepth 1 -name 'FAILED-*' -type d 2>/dev/null | wc -l)

    if (( age_h > MAX_AGE_HOURS )); then
        problems+="$name: последняя успешная копия $age_h ч назад (порог $MAX_AGE_HOURS ч)"$'\n'
        rc=1
        say "  [ ПРОСРОЧЕНА ] $name: $snapshot, $age_h ч назад, снимков: $count"
    else
        say "  [ OK ] $name: $snapshot, $age_h ч назад, снимков: $count"
    fi

    if (( failed > 0 )); then
        problems+="$name: незавершённых снимков (FAILED-*): $failed"$'\n'
        rc=1
    fi
done
shopt -u nullglob

if [[ -n "$problems" ]]; then
    say ""
    say "Проблемы:"
    say "$problems"
    if [[ "$MAIL_ENABLED" == "yes" ]]; then
        printf 'Сервер: %s\n\n%s\n' "$(hostname -f)" "$problems" \
            | mail -s "[NEKTA][ВНИМАНИЕ] Проблемы резервного копирования" "$MAIL_TO" 2>/dev/null || true
    fi
fi

exit "$rc"
