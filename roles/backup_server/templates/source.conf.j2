# {{ ansible_managed }}
# Описание защищаемого сервера «{{ item.name }}».

NAME="{{ item.name }}"
HOST="{{ item.host }}"
PORT={{ item.port | default(22) }}
SSH_USER="{{ item.user | default('nekta-backup') }}"

# Копируемые пути (как они выглядят на защищаемом сервере).
PATHS=(
{% for path in item.paths %}
    "{{ path }}"
{% endfor %}
)

# Исключения rsync.
EXCLUDES=(
{% for pattern in item.exclude | default([]) %}
    "{{ pattern }}"
{% endfor %}
    "/proc/*"
    "/sys/*"
    "/dev/*"
    "/run/*"
    "/tmp/*"
    "*.pid"
    "lost+found"
)

# Запускать ли перед копированием подготовку согласованных дампов СУБД.
PREDUMP="{{ 'yes' if item.predump | default(true) | bool else 'no' }}"
