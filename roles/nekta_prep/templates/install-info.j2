# {{ ansible_managed }}
# Паспорт подготовки сервера. Эти данные передаются в техподдержку Nekta
# (support@nekta.tech) вместе с реквизитами доступа.

Хост:                 {{ inventory_hostname }}
Адрес:                {{ ansible_host | default(ansible_facts.default_ipv4.address | default('n/a')) }}
ОС:                   {{ ansible_facts.distribution }} {{ ansible_facts.distribution_version }}
Ядро:                 {{ ansible_facts.kernel }}
CPU:                  {{ ansible_facts.processor_cores * ansible_facts.processor_count }} ядер / {{ ansible_facts.processor_vcpus }} потоков
ОЗУ:                  {{ (ansible_facts.memtotal_mb / 1024) | round(1) }} ГБ
Том данных:           {{ nekta_data_dir }}
Порт SSH:             {{ common_ssh_port | default(22) }}

Профиль нагрузки:     до {{ nekta_profile_devices }} устройств
Сообщений на прибор:  {{ nekta_msgs_per_device_per_day }} в сутки
Глубина хранения:     {{ nekta_retention_years }} г.
Расчётный объём:      {{ nekta_storage_required_gb | default('n/a') }} ГБ (включая запас {{ nekta_storage_overhead_percent }}%)

{% if nekta_public_url is defined %}
URL web-интерфейса:   {{ nekta_public_url }}
{% endif %}
{% if nekta_admin_email is defined %}
E-mail администратора:{{ nekta_admin_email }}
{% endif %}

Подготовлено Ansible: {{ ansible_date_time.iso8601 | default('n/a') }}
