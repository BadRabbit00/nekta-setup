#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Подготовка сервера Nekta к снятию резервной копии.
#
# Побайтовое копирование работающей СУБД (файлы данных PostgreSQL, MongoDB и
# т.п.) даёт несогласованный снимок: восстановление из него в лучшем случае
# требует отката журнала, в худшем — не проходит. Поэтому перед копированием
# делаем логические дампы штатными средствами самих СУБД, а rsync забирает
# уже готовые файлы.
#
# Скрипт вызывается сервером резервного копирования по SSH:
#     ssh {{ nekta_backup_user }}@host sudo /usr/local/sbin/nekta-predump
set -uo pipefail

DUMP_DIR="{{ nekta_predump_dir }}"
KEEP={{ nekta_predump_keep }}
STAMP="$(date +%Y-%m-%d_%H%M%S)"
TARGET="${DUMP_DIR}/${STAMP}"
LOG_TAG="nekta-predump"
rc=0

log()  { logger -t "$LOG_TAG" -- "$*"; echo "[$(date +%H:%M:%S)] $*"; }
warn() { log "ВНИМАНИЕ: $*"; rc=1; }

mkdir -p "$TARGET"/{db,system}
chmod 0750 "$DUMP_DIR" "$TARGET"

log "каталог дампов: $TARGET"

# --- Состояние системы ----------------------------------------------------
# Пригодится при восстановлении на новом железе: какие контейнеры и образы
# были запущены, какие пакеты и сетевые настройки использовались.
collect_system_state() {
    local d="$TARGET/system"
    dpkg -l                      > "$d/dpkg-list.txt"            2>/dev/null || true
    ip -o addr                   > "$d/ip-addr.txt"              2>/dev/null || true
    ip route                     > "$d/ip-route.txt"             2>/dev/null || true
    ufw status verbose           > "$d/ufw-status.txt"           2>/dev/null || true
    lsblk -o NAME,SIZE,TYPE,FSTYPE,UUID,MOUNTPOINT > "$d/lsblk.txt" 2>/dev/null || true
    cat /proc/mdstat             > "$d/mdstat.txt"               2>/dev/null || true
    systemctl list-unit-files --state=enabled > "$d/enabled-units.txt" 2>/dev/null || true
    if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
        docker ps -a --format '{% raw %}{{.Names}}\t{{.Image}}\t{{.Status}}{% endraw %}' > "$d/docker-ps.txt" 2>/dev/null || true
        docker images --format '{% raw %}{{.Repository}}:{{.Tag}}\t{{.ID}}{% endraw %}'  > "$d/docker-images.txt" 2>/dev/null || true
        docker volume ls -q      > "$d/docker-volumes.txt"       2>/dev/null || true
        docker network ls        > "$d/docker-networks.txt"      2>/dev/null || true
    fi
    log "состояние системы собрано"
}

# --- Дампы баз данных из контейнеров -------------------------------------
containers_by_image() {
    # $1 — фрагмент имени образа (postgres, mongo, ...)
    docker ps --format '{% raw %}{{.Names}}\t{{.Image}}{% endraw %}' 2>/dev/null \
        | awk -F'\t' -v pat="$1" 'tolower($2) ~ pat {print $1}'
}

dump_postgres() {
    local c="$1" out="$TARGET/db/postgres_${c}.sql.gz"
    local user
    user="$(docker exec "$c" printenv POSTGRES_USER 2>/dev/null || echo postgres)"
    log "PostgreSQL: дамп кластера из контейнера $c (пользователь $user)"
    if docker exec "$c" pg_dumpall -U "$user" 2>/dev/null | gzip -c > "$out"; then
        [ -s "$out" ] || warn "пустой дамп PostgreSQL из $c"
    else
        warn "не удалось снять дамп PostgreSQL из $c"
    fi
}

dump_mongo() {
    local c="$1" out="$TARGET/db/mongo_${c}.archive.gz"
    local tool="mongodump"
    docker exec "$c" sh -c 'command -v mongodump' >/dev/null 2>&1 || {
        warn "в контейнере $c нет mongodump"; return
    }
    log "MongoDB: дамп из контейнера $c"
    local auth=()
    local mu mp
    mu="$(docker exec "$c" printenv MONGO_INITDB_ROOT_USERNAME 2>/dev/null || true)"
    mp="$(docker exec "$c" printenv MONGO_INITDB_ROOT_PASSWORD 2>/dev/null || true)"
    if [ -n "$mu" ] && [ -n "$mp" ]; then
        auth=(-u "$mu" -p "$mp" --authenticationDatabase admin)
    fi
    if docker exec "$c" "$tool" "${auth[@]}" --archive --gzip > "$out" 2>/dev/null; then
        [ -s "$out" ] || warn "пустой дамп MongoDB из $c"
    else
        warn "не удалось снять дамп MongoDB из $c"
    fi
}

dump_mysql() {
    local c="$1" out="$TARGET/db/mysql_${c}.sql.gz"
    local pw
    pw="$(docker exec "$c" printenv MYSQL_ROOT_PASSWORD 2>/dev/null || true)"
    log "MySQL/MariaDB: дамп из контейнера $c"
    if docker exec -e MYSQL_PWD="$pw" "$c" \
        mysqldump -u root --all-databases --single-transaction --quick --routines --events 2>/dev/null \
        | gzip -c > "$out"; then
        [ -s "$out" ] || warn "пустой дамп MySQL из $c"
    else
        warn "не удалось снять дамп MySQL из $c"
    fi
}

dump_clickhouse() {
    local c="$1" out="$TARGET/db/clickhouse_${c}_schema.sql"
    log "ClickHouse: выгрузка схемы из контейнера $c"
    docker exec "$c" clickhouse-client --query \
        "SELECT concat(create_table_query, ';') FROM system.tables WHERE database NOT IN ('system','INFORMATION_SCHEMA','information_schema')" \
        > "$out" 2>/dev/null || warn "не удалось выгрузить схему ClickHouse из $c"
    # Данные ClickHouse забираются файловым копированием: логический дамп
    # таблиц с показаниями за годы хранения непрактичен по объёму и времени.
}

dump_databases() {
    if ! command -v docker >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then
        log "docker недоступен — стек Nekta ещё не установлен, дампы БД пропущены"
        return
    fi

    local found=0 c
    for c in $(containers_by_image 'postgres|timescale'); do dump_postgres "$c";   found=1; done
    for c in $(containers_by_image 'mongo');              do dump_mongo "$c";      found=1; done
    for c in $(containers_by_image 'mysql|mariadb');      do dump_mysql "$c";      found=1; done
    for c in $(containers_by_image 'clickhouse');         do dump_clickhouse "$c"; found=1; done

    [ "$found" -eq 1 ] || log "контейнеры с СУБД не обнаружены"
}

rotate() {
    # Держим на сервере Nekta только несколько последних дампов: долгую
    # историю хранит сервер резервного копирования.
    local count
    count=$(find "$DUMP_DIR" -maxdepth 1 -mindepth 1 -type d -printf '.' | wc -c)
    if [ "$count" -gt "$KEEP" ]; then
        find "$DUMP_DIR" -maxdepth 1 -mindepth 1 -type d -printf '%T@ %p\n' \
            | sort -n | head -n "$((count - KEEP))" | cut -d' ' -f2- \
            | while read -r old; do
                log "удаляю устаревший дамп: $old"
                rm -rf -- "$old"
            done
    fi
}

collect_system_state
dump_databases
rotate

# Ссылка latest — по ней сервер резервного копирования всегда находит
# самый свежий дамп.
ln -sfn "$TARGET" "$DUMP_DIR/latest"

du -sh "$TARGET" | while read -r size _; do log "готово, объём дампов: $size"; done
[ "$rc" -eq 0 ] && log "подготовка завершена без ошибок" || log "подготовка завершена с замечаниями"
exit "$rc"
