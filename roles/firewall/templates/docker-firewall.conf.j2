# {{ ansible_managed }}
# Правила для цепочки DOCKER-USER. Действуют на трафик, который docker
# заворачивает в опубликованные порты контейнеров в обход ufw.
#
# Формат: <порт> <tcp|udp> <источник CIDR>
# Пустой файл или RESTRICT=no — доступ к портам контейнеров не ограничивается.

RESTRICT={{ 'yes' if firewall_restrict_docker_ports | bool else 'no' }}

{% for rule in firewall_docker_allowed_sources %}
{{ rule.port }} {{ rule.proto | default('tcp') }} {{ rule.source }}
{% endfor %}
