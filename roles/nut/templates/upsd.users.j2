# {{ ansible_managed }}
# Права: admin — управление ИБП и тесты, monitor — только чтение состояния
# и получение команды на выключение.

[{{ nut_admin_user }}]
    password = {{ nut_admin_password }}
    actions = SET
    instcmds = ALL

[{{ nut_monitor_user }}]
    password = {{ nut_monitor_password }}
    upsmon primary
